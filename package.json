{
	"name": "whack-a-dictator",
	"version": "1.0.0",
	"description": "Whack-A-Dictator Stream Deck plugin",
	"private": true,
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"assets": "node scripts/build-assets.mjs",
		"profiles": "node scripts/build-profiles.mjs",
		"build": "npm run assets && npm run profiles && rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"npm run deploy\"",
		"typecheck": "tsc --noEmit",
		"validate": "streamdeck validate com.goldenbunker.whackadictator.sdPlugin",
		"pack": "streamdeck pack com.goldenbunker.whackadictator.sdPlugin --output release --force",
		"deploy": "node scripts/deploy.mjs",
		"preview": "node scripts/preview.mjs",
		"face": "node scripts/preview-face.mjs",
		"doctor": "node scripts/doctor.mjs"
	},
	"dependencies": {
		"@elgato/streamdeck": "^2.1.0"
	},
	"devDependencies": {
		"@elgato/cli": "^1.7.4",
		"@rollup/plugin-commonjs": "^28.0.2",
		"@rollup/plugin-node-resolve": "^16.0.0",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.1.2",
		"@types/node": "^22.13.1",
		"rollup": "^4.34.6",
		"sharp": "^0.35.3",
		"tslib": "^2.8.1",
		"typescript": "^5.7.3"
	}
}
